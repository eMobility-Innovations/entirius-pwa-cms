VUE_APP_API_URL=
VUE_APP_CHANNEL=
VUE_APP_DEBUG=false
VUE_APP_LANG=EN
VUE_APP_USERNAME=
VUE_APP_PASSWORD=
# Comma-separated panel IDs: pages, pim, points
VUE_APP_PANELS=pages,pim,points

# --- optional OIDC single sign-on --------------------------------------------
# "true" enables it. Anything else (including unset) leaves the CMS exactly as it is:
# no SSO button, no /sso/callback route, no SSO request. The browser never holds a
# client secret — the backend performs the code exchange.
VUE_APP_SSO_ENABLED=false
# Backend endpoints. Defaults suit django_escootersauth; override for another backend.
VUE_APP_SSO_LOGIN_URL_PATH=/api/escootersauth/v2/staff/login-url/
VUE_APP_SSO_CALLBACK_PATH=/api/escootersauth/v2/staff/callback/
# "true" ALSO removes the password form: the login wall renders no username/password
# fields and goes straight to the provider, and "change password" is hidden because the
# account has none. Ignored unless VUE_APP_SSO_ENABLED is also "true".
VUE_APP_SSO_ONLY=false
