{
  "$description": "Old CMS token -> new semantic token, keyed by the role the old token plays at the use site (CSS property for var(), utility prefix for classes: t=text, bg=surface, b/bb/bt/bl/br/o=border, stroke=icon). Codemod input for P2; scripts/migration.py counts every row against the CMS src. `manual` = the role alone does not decide, a person/agent picks per use site.",
  "color": {
    "basic-100":       { "surface": "surface-base", "text": "text-on-accent-fill", "border": "border-subtle", "shadow": "surface-base",
                         "manual": "surface: inputs/selects/textareas in boots -> surface-sunken; text: on status fills -> text-on-status-fill, on bg-basic-600..800 -> text-inverse (see tech-notes 'basic-100 as text')" },
    "basic-150":       { "surface": "surface-raised", "manual": "token was never defined (PIM, 5 uses fall back to nothing)" },
    "basic-200":       { "surface": "surface-raised", "border": "border-subtle", "text": "text-muted", "alias": "surface-raised" },
    "basic-300":       { "border": "border-subtle", "surface": "surface-hover", "text": "text-muted", "alias": "border-subtle" },
    "basic-400":       { "border": "border-default", "text": "text-muted", "surface": "surface-hover" },
    "basic-500":       { "text": "text-muted", "border": "border-default", "surface": "surface-disabled" },
    "basic-600":       { "text": "text-secondary", "icon": "text-secondary", "border": "border-strong", "surface": "surface-inverse" },
    "basic-700":       { "text": "text-body", "surface": "surface-inverse", "border": "border-strong" },
    "basic-800":       { "text": "text-body", "surface": "surface-inverse", "border": "border-strong", "icon": "text-body" },
    "basic-900":       { "text": "text-strong", "surface": "surface-inverse", "border": "border-strong" },
    "support-100":     { "surface": "accent-subtle", "border": "accent" },
    "support-200":     { "surface": "accent-subtle", "border": "accent" },
    "support-300":     { "border": "accent", "surface": "accent-fill", "text": "text-accent" },
    "support-400":     { "text": "text-accent", "surface": "accent-fill", "border": "accent", "shadow": "focus-ring", "other:accent-color": "accent" },
    "primary-100":     { "surface": "accent-fill", "text": "text-accent" },
    "primary-200":     { "surface": "accent-fill-hover", "border": "accent", "shadow": "focus-ring" },
    "primary-300":     { "text": "text-accent" },
    "positive-100":    { "surface": "positive-subtle" },
    "positive-200":    { "text": "positive", "surface": "positive-fill", "border": "positive", "icon": "positive" },
    "positive-300":    { "text": "positive", "surface": "positive-fill", "border": "positive" },
    "negative-100":    { "surface": "negative-subtle" },
    "negative-200":    { "text": "negative", "surface": "negative-fill", "border": "negative" },
    "negative-300":    { "text": "negative", "surface": "negative-fill", "border": "negative" },
    "negative-400":    { "text": "negative", "manual": "undefined shade (EnvMissing.vue)" },
    "negative-500":    { "text": "negative", "manual": "undefined shade (EnvMissing.vue)" },
    "warning-100":     { "surface": "warning-subtle" },
    "warning-200":     { "text": "warning", "border": "warning", "icon": "warning", "surface": "warning-fill" },
    "warning-300":     { "text": "warning", "border": "warning", "surface": "warning-fill" },
    "warning-400":     { "text": "warning", "manual": "undefined shade (EnvMissing.vue)" },
    "warning-500":     { "text": "warning", "manual": "undefined shade (EnvMissing.vue)" },
    "informative-100": { "surface": "info-subtle" },
    "informative-200": { "text": "info", "border": "info", "surface": "info-fill" },
    "informative-300": { "text": "info", "border": "info", "surface": "info-fill" },
    "notice-100":      { "delete": "0 uses" },
    "notice-200":      { "delete": "0 uses" }
  },
  "class_prefix": { "t": "t-", "bg": "bg-", "b": "b-", "bb": "bb-", "bt": "bt-", "bl": "bl-", "br": "br-", "o": "o-", "stroke": "stroke-" },
  "class_suffix_rule": "new class = <prefix> + semantic name without its group prefix: text-muted -> t-muted, surface-raised -> bg-raised, border-subtle -> b-subtle, accent-fill -> bg-accent-fill, positive-subtle -> bg-positive-subtle. `-hover` variants are kept (t-muted-hover).",
  "space": { "--space-0": "0 -> 0", "--space-50": "5 -> 4", "--space-100": "10 -> 8", "--space-200": "20 -> 20", "--space-300": "30 -> 32", "--space-400": "40 -> 40", "--space-500": "50 -> 48", "--space-600": "60 -> 64", "--space-700": "120 -> 120", "new": { "--space-125": 12, "--space-150": 16, "--space-250": 24 } },
  "radius": { "--radius-sm": "--radius-base (4 -> 4)", "--radius-md": "--radius-base (6 -> 4)", "--radius-lg": "--radius-lg (8 -> 8)", ".radius-sm": ".radius-base", ".radius-md": ".radius-base", ".radius-lg": ".radius-lg",
              "raw": { "2px": "--radius-base", "3px": "--radius-base", "4px": "--radius-base", "5px": "--radius-base", "6px": "--radius-base", "8px": "--radius-lg", "9px": "--radius-lg", "10px": "--radius-xl", "11px": "--radius-xl", "12px": "--radius-xl", "0.75rem": "--radius-xl", "1rem": "--radius-2xl", "50%": "--radius-full", "50px": "--radius-full", "999px": "--radius-full" } },
  "shadow": { "--shadow-sm|md|lg|down": "same name, dark value from brand shadow.*", "--shadow-arrow|right|left|top|around": "same name, CMS-local; 1 use each" },
  "font_size": { "--fs-100": "10", "--fs-200": "12", "--fs-300": "14", "--fs-400": "16", "--fs-500": "18 -> 20", "--fs-600": "24", "--fs-700": "28 -> 30", "--fs-800|900|1000": "delete (0 uses)", "new": { "--fs-150": 11, "--fs-250": 13 } },
  "gradient": { "--gradient-main-bg": "delete; App.vue .main-bg-theme -> bg-page (flat black)", "--gradient-blue|blue-light|tech|subtle": "delete (0 uses)", ".bg-gradient-*|.text-gradient-*": "delete (0 uses)" },
  "editor": { "--editor-table-header-bg": "accent-subtle", "--editor-table-header-bg-alt": "surface-raised", "--editor-table-header-text": "text-strong", "--editor-table-even-row": "surface-raised" }
}
