{
  "name": "entirius-pwa-cms",
  "version": "2.1.0",
  "private": true,
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preserve": "node scripts/init-client.js",
    "prebuild": "node scripts/init-client.js",
    "init:client": "node scripts/init-client.js",
    "serve": "vue-cli-service serve",
    "start": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "pretty": "prettier --write \"./**/*.vue\"",
    "test": "npm run test:build && npm run test:e2e",
    "test:build": "node tests/build/build-test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/e2e/01-smoke.spec.js",
    "test:content": "playwright test tests/e2e/03-content-builder.spec.js",
    "test:gallery": "playwright test tests/e2e/04-gallery-upload.spec.js",
    "test:layout": "playwright test tests/e2e/05-theme-and-layout.spec.js",
    "test:content-list": "playwright test tests/e2e/06-content-list.spec.js",
    "test:validate": "playwright test tests/e2e/00-dev-validate.spec.js",
    "test:pim": "playwright test tests/e2e/07-pim-smoke.spec.js",
    "test:navigation": "playwright test tests/e2e/08-navigation-editor.spec.js",
    "test:suppliers": "playwright test tests/e2e/09-suppliers-smoke.spec.js tests/e2e/10-supplier-review-smoke.spec.js",
    "test:suppliers:live": "playwright test tests/e2e/11-suppliers-live.spec.js --workers=1",
    "test:comprehensive": "playwright test tests/e2e/03-content-builder.spec.js tests/e2e/04-gallery-upload.spec.js tests/e2e/05-theme-and-layout.spec.js tests/e2e/06-content-list.spec.js",
    "pretest:unit": "node scripts/init-client.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:pim-bridge": "playwright test tests/e2e/12-pim-suppliers-bridge.spec.js",
    "test:lookup": "playwright test tests/e2e/13-lookup-dropzone.spec.js",
    "test:scroll": "playwright test --config=playwright.layout.config.js",
    "test:hooks": "bash tests/hooks/no-ai-attribution.test.sh"
  },
