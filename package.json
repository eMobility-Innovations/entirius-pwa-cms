{
  "name": "entirius-pwa-cms",
  "version": "3.3.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "Admin CMS of Entirius: a Vue 3 single-page app with a visual page builder and per-module panels",
  "keywords": [
    "entirius",
    "ecommerce",
    "cms",
    "admin",
    "vue",
    "page-builder"
  ],
  "homepage": "https://docs.entirius.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entirius/entirius-pwa-cms.git"
  },
  "bugs": {
    "url": "https://github.com/entirius/entirius-pwa-cms/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "preserve": "node scripts/init-client.js",
    "prebuild": "node scripts/init-client.js",
    "init:client": "node scripts/init-client.js",
    "serve": "vue-cli-service serve",
    "start": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "pretty": "prettier --write \"./**/*.vue\"",
    "lint:ui": "stylelint \"src/**/*.{vue,scss}\" && eslint \"src/**/*.vue\" && node scripts/codemods/p2-scales.mjs --check && npm run audit:readonly",
    "audit:readonly": "node scripts/audit/readonly.mjs --fail-on-findings",
    "test": "npm run test:build && npm run test:e2e",
    "test:build": "node tests/build/build-test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/e2e/01-smoke.spec.js",
    "test:content": "playwright test tests/e2e/03-content-builder.spec.js",
    "test:gallery": "playwright test tests/e2e/04-gallery-upload.spec.js",
    "test:layout": "playwright test tests/e2e/05-theme-and-layout.spec.js",
    "test:content-list": "playwright test tests/e2e/06-content-list.spec.js",
    "test:validate": "playwright test tests/e2e/00-dev-validate.spec.js",
    "test:pim": "playwright test tests/e2e/07-pim-smoke.spec.js",
    "test:navigation": "playwright test tests/e2e/08-navigation-editor.spec.js",
    "test:suppliers": "playwright test tests/e2e/09-suppliers-smoke.spec.js tests/e2e/10-supplier-review-smoke.spec.js",
    "test:suppliers:live": "playwright test tests/e2e/11-suppliers-live.spec.js --workers=1",
    "test:comprehensive": "playwright test tests/e2e/03-content-builder.spec.js tests/e2e/04-gallery-upload.spec.js tests/e2e/05-theme-and-layout.spec.js tests/e2e/06-content-list.spec.js",
    "pretest:unit": "node scripts/init-client.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:pim-bridge": "playwright test tests/e2e/12-pim-suppliers-bridge.spec.js",
    "test:lookup": "playwright test tests/e2e/13-lookup-dropzone.spec.js",
    "visual": "playwright test -c tests/visual/playwright.visual.config.js",
    "visual:parity": "playwright test -c tests/visual/playwright.visual.config.js --grep @parity",
    "visual:screens": "playwright test -c tests/visual/playwright.visual.config.js --grep @screens",
    "visual:approve": "playwright test -c tests/visual/playwright.visual.config.js --grep @screens --update-snapshots",
    "visual:landmarks": "playwright test -c tests/visual/playwright.visual.config.js --grep @landmarks",
    "visual:ux": "playwright test -c tests/visual/playwright.visual.config.js --grep @ux --workers=6 --fully-parallel",
    "visual:catalogue": "playwright test -c tests/visual/playwright.visual.config.js --grep @catalogue",
    "visual:components": "playwright test -c tests/visual/playwright.visual.config.js --grep @components",
    "visual:approve:components": "playwright test -c tests/visual/playwright.visual.config.js --grep @components --update-snapshots"
  },
  "dependencies": {
    "@entirius/brand-tokens": "github:entirius/entirius-pwa-brand-tokens#v0.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lexend-deca": "5.3.0",
    "@fortawesome/fontawesome-svg-core": "^1.3.0",
    "@fortawesome/free-regular-svg-icons": "^6.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@fortawesome/vue-fontawesome": "^3.0.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "axios": "^1.19.0",
    "core-js": "^3.6.5",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "dotenv": "^16.0.0",
    "flatpickr": "^4.6.13",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "pinia": "^3.0.4",
    "swiper": "^14.1.0",
    "universal-cookie": "^7.0.0",
    "uuid": "^11.1.1",
    "vue": "^3.5.44",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.11.6",
    "jsdom": "30.1.2",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "raw-loader": "^4.0.2",
    "sass": "^1.103.1",
    "sass-loader": "^10.2.0",
    "stylelint": "^17.15.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "webpack": "^5.109.2",
    "webpack-dev-middleware@^5": "^5.3.4",
    "terser-webpack-plugin@^5": "^5.6.1",
    "css-minimizer-webpack-plugin@^3": "^3.4.1",
    "launch-editor": "^2.14.1",
    "shell-quote": "^1.10.0",
    "websocket-driver": "^0.7.5",
    "express@^4": "^4.22.2",
    "compression": "^1.8.1",
    "on-headers": "^1.1.0",
    "http-proxy-middleware@^2": "^2.0.10",
    "node-forge": "^1.4.0",
    "serialize-javascript": "^7.1.0",
    "svgo@^2": "^2.8.4",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "minimatch@^3": "^3.1.5",
    "brace-expansion@^1": "^1.1.18",
    "brace-expansion@^2": "^2.1.4",
    "cross-spawn": "^7.0.6",
    "nanoid@^3": "^3.3.18",
    "postcss@^8": "^8.5.26",
    "picomatch@^2": "^2.3.2",
    "joi@^17": "^17.13.6",
    "ajv@^6": "^6.15.0",
    "ajv@^8": "^8.20.0",
    "markdown-it@^14": "^14.3.0",
    "linkify-it@^5": "^5.0.2",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "fast-uri": "^3.1.6",
    "webpack-dev-server": "^5.2.6",
    "@vue/component-compiler-utils": {
      "postcss": "^8.5.26"
    }
  }
}
